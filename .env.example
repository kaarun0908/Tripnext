# TripNest Environment Variables Configuration Template
SECRET_KEY=change-this-to-a-secure-random-secret-key
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True

# Database Configuration (PostgreSQL)
# Format: postgresql://username:password@hostname:port/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripnest
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripnest_test

# Server Port
PORT=5000
